@page "/libro"
@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Threading.Tasks;

@using Microsoft.Extensions.Configuration;
@using Microsoft.EntityFrameworkCore;
@using ProyectoBiblioteca.Data
@using ProyectoBiblioteca.Data.Configs
@using ProyectoBiblioteca.Models
@using ProyectoBiblioteca.FormLogic

@namespace ProyectoBiblioteca.Pages
@inherits LibroFormBase

@inject NavigationManager nv
@inject LoginState ls
@if(ls.UsuarioActual is null || ls.UsuarioActual == 0)
{
    nv.NavigateTo("/");
}

@inject IDbContextFactory<ProyectoBibliotecaDbContext> DbFactory
@*using var db = DbFactory.CreateDbContext();
*@
@{
    using var db = DbFactory.CreateDbContext();
    var Lista = (from g in db.Generos
                  select g).ToList();
} 

<h2>Crear Libro</h2>

<EditForm EditContext="@editContext" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div>
        <label>Titulo:</label>
        <InputText @bind-Value="libro.titulo" class="form-control" placeholder="Titulo del libro"/>
        <p class="text-danger mt-3"> <ValidationMessage For="@(() => libro.titulo)" /> </p>
    </div>

    <div>
        <label>Género:</label>
        <InputSelect @bind-Value="libro.idGenero">
            <option value="">-- Elige El Genero --</option>
            @foreach (var g in Lista)
            {
                <option value="@g.idGenero">@g.genero</option>
            }
        </InputSelect>
        <p class="text-danger mt-3"><ValidationMessage For="@(() => libro.idGenero)" /></p>
    </div>

    <div>
        <label>Editorial:</label>
        <InputText @bind-Value="libro.editorial" class="form-control " placeholder="Editorial del libro"/>
        <p class="text-danger mt-3"><ValidationMessage For="@(() => libro.editorial)" /></p>
    </div>

    <div>
        <label>Autor:</label>
        <InputText @bind-Value="libro.autor" class="form-control" placeholder="Autor del libro"/>
        <p class="text-danger mt-3"><ValidationMessage For="@(() => libro.autor)" /></p>
    </div>

    <div>
        <label>Cantidad Páginas:</label>
        <InputNumber TValue="int" @bind-Value="libro.cantidadPaginas" class="form-control" placeholder="Cantidad de paginas del libro"/>
        <p class="text-danger mt-3"> <ValidationMessage For="@(() => libro.cantidadPaginas)" /></p>
    </div>
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="text-success mt-1">@mensaje</div>
    }

    <button type="submit" class="btn btn-primary mt-3">Registrar</button>
</EditForm>