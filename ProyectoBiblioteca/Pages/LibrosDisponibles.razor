@page "/disponibles"

@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Threading.Tasks;

@using Microsoft.Extensions.Configuration;
@using Microsoft.EntityFrameworkCore;
@using ProyectoBiblioteca.Data
@using ProyectoBiblioteca.Data.Configs
@using ProyectoBiblioteca.Models
@using ZstdSharp.Unsafe

@inject NavigationManager nv
@inject LoginState ls

@if(ls.UsuarioActual is null || ls.UsuarioActual == 0)
{
    nv.NavigateTo("/");
}

@inject IDbContextFactory<ProyectoBibliotecaDbContext> DbFactory
@*using var db = DbFactory.CreateDbContext();
*@
@{
    var Listas = FiltrarTitulo();
}

<h2 class="title">Títulos de Nuestra Biblioteca</h2>
<h4>Filtrar libros por Titulo</h4>

<input class="form-control w-25 me-sm-2" type="search" placeholder="ingrese un titulo" @bind-value="titulo">
<button class="btn btn-secondary my-2 my-sm-0" type="submit" @onclick="Filtrar">Buscar</button>

<br>
<h5 class="title custom-title-padding-bottom">Listado de estos:</h5>

<div class="tabla-responsive-wrapper">
    <table class="tabla-estilizada">
        <thead>
            <tr>
                <th>Título</th>
                <th>Género</th>
                <th>Autor</th>
                <th>Editorial</th>
                <th>Fecha Creación</th>
                <th>Páginas</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var list in Listas)
            {
                <tr>
                    <td>@list.l.titulo</td>
                    <td>@list.g.genero</td>
                    <td>@list.l.autor</td>
                    <td>@list.l.editorial</td>
                    <td>@list.l.fechaCreacion.ToShortDateString()</td>
                    <td>@list.l.cantidadPaginas</td>   
                </tr>                 
            }
        </tbody>
    </table>
</div>



@code{
    string titulo = string.Empty;
    public void Filtrar()
    {
        StateHasChanged();
    }
    public List<(Genero g, Libro l)> FiltrarTitulo()
    {
        using var db = DbFactory.CreateDbContext();

        if (string.IsNullOrEmpty(titulo))
        {
            // EF ejecuta el query usando tipos anónimos
            var query = (
                from l in db.Libros
                join g in db.Generos on l.idGenero equals g.idGenero
                select new { g, l }
            )
            .AsEnumerable()      // A partir de acá ya no es árbol de expresión
            .Select(x => (x.g, x.l))   // Ahora sí puedo usar tuplas
            .ToList();

            return query;
        }
        else
        {
            var query = (
                from l in db.Libros
                where titulo == l.titulo
                join g in db.Generos on l.idGenero equals g.idGenero
                select new { g, l }
            )
            .AsEnumerable()
            .Select(x => (x.g, x.l))
            .ToList();

            return query;
        }
    }


}