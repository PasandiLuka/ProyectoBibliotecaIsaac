@page "/disponibles"

@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Threading.Tasks;

@using Microsoft.Extensions.Configuration;
@using Microsoft.EntityFrameworkCore;
@using ProyectoBiblioteca.Data
@using ProyectoBiblioteca.Data.Configs
@using ProyectoBiblioteca.Models

@inject NavigationManager NavigationManager

@inject IDbContextFactory<ProyectoBibliotecaDbContext> DbFactory
@*using var db = DbFactory.CreateDbContext();
*@

@{
    using var db = DbFactory.CreateDbContext();
    var Listas = (from l in db.Libros 
                  join g in db.Generos on l.idGenero equals g.idGenero
                  select new {l, g}).ToList();
} 
<h2 class="title">Títulos de Nuestra Biblioteca</h2>
<h5 class="title custom-title-padding-bottom">Listado de estos:</h5>

<div class="tabla-responsive-wrapper">
    <table class="tabla-estilizada">
        <thead>
            <tr>
                <th>Título</th>
                <th>Género</th>
                <th>Autor</th>
                <th>Editorial</th>
                <th>Fecha Creación</th>
                <th>Páginas</th>
                <th>Calificación</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var list in Listas)
            {
                <tr>
                    <td>@list.l.titulo</td>
                    <td>@list.g.genero</td>
                    <td>@list.l.autor</td>
                    <td>@list.l.editorial</td>
                    <td>@list.l.fechaCreacion.ToShortDateString()</td>
                    <td>@list.l.cantidadPaginas</td>
                    <td>@list.l.calificacionPromedio</td>        
                </tr>                 
            }
        </tbody>
    </table>
</div>

<div>
    <p class="custom-text weight font-bold">¿Quieres crear un nuevo libro?</p>
    <div class=" button-align">
        <button class="btn btn-primary custom-button" @onclick="CrearLibro">Cree un libro</button>
    </div>
    <br><br><br><br>
</div>


@code{
    public void CrearLibro()
    {
        NavigationManager.NavigateTo("/libro");
    }
}