@page "/disponibles"

@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Threading.Tasks;

@using Microsoft.Extensions.Configuration;
@using Microsoft.EntityFrameworkCore;
@using ProyectoBiblioteca.Data
@using ProyectoBiblioteca.Data.Configs
@using ProyectoBiblioteca.Models

@inject NavigationManager NavigationManager

@inject IDbContextFactory<ProyectoBibliotecaDbContext> DbFactory
@*using var db = DbFactory.CreateDbContext();
*@

@{
    using var db = DbFactory.CreateDbContext();
    var Listas = (from l in db.Libros 
                  join g in db.Generos on l.idGenero equals g.idGenero
                  select new {l, g}).ToList();
} 
<h1 class="title">Titulos de Nuestra Biblioteca</h1>
<h2 class="custom-text">Listado de estos:</h2>
<table class="table table-margin">
        <thead class="custom-padding-table">
            <tr class="table-secondary custom-padding-table">
                <th class="custom-text-size">Título</th>
                <th class="custom-text-size">Genero</th>
                <th class="custom-text-size">Autor</th>
                <th class="custom-text-size">Editorial</th>
                <th class="custom-text-size">FechaCreación</th>
                <th class="custom-text-size">Paginas</th>
                <th class="custom-text-size">Calificación</th>
            </tr>
        </thead>
        <tbody class="custom-padding-table">
            @foreach (var list in Listas)
            {
                <tr class="table-dark custom-padding-table">
                    <td>@list.l.titulo</td>
                    <td>@list.g.genero</td>
                    <td>@list.l.autor</td>
                    <td>@list.l.editorial</td>
                    <td>@list.l.fechaCreacion</td>
                    <td>@list.l.cantidadPaginas</td>
                    <td>@list.l.calificacionPromedio</td>        
                </tr>                 
            }
        </tbody>
    </table>

<div>
    <p class="custom-text weight">Quieres crear un nuevo libro</p>
    <div class=" button-align">
        <button class="btn btn-light custom-button" @onclick="CrearLibro">Crear un libro</button>
    </div>
    <br><br><br><br>
</div>


@code{
    public void CrearLibro()
    {
        NavigationManager.NavigateTo("/libro");
    }
}