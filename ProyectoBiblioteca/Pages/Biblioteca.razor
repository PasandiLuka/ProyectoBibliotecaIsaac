@page "/biblioteca"
@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Threading.Tasks;

@using Microsoft.Extensions.Configuration;
@using Microsoft.EntityFrameworkCore;
@using ProyectoBiblioteca.Data
@using ProyectoBiblioteca.Data.Configs
@using ProyectoBiblioteca.Models

@inherits BibliotecaFormBase

@inject LoginState ls

@inject IDbContextFactory<ProyectoBibliotecaDbContext> DbFactory
@*using var db = DbFactory.CreateDbContext();
*@

@{
    using var db = DbFactory.CreateDbContext();
    var Listas = db.Libros
                    .GroupJoin(
                        db.Bibliotecas.Where(b => b.idUsuario == ls.UsuarioActual),
                        l => l.idLibro,
                        b => b.idLibro,
                        (l, grp) => new { Libro = l, Bibliotecas = grp })
                    .SelectMany(
                        x => x.Bibliotecas.DefaultIfEmpty(),
                        (x, bnull) => new { Libro = x.Libro, Biblioteca = bnull })
                    .Where(x => x.Biblioteca == null)
                    .Select(x => new { l = x.Libro, g = x.Libro.genero })
                    .ToList();
} 

<h1 class="title custom-title-padding-bottom">Libros</h1>

<EditForm EditContext="@editContext" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <table class="table table-margin">
        <thead class="custom-padding-table">
            <tr class="table-secondary custom-padding-table">
                <th>Título</th>
                <th>Genero</th>
                <th>Autor</th>
                <th>Editorial</th>
                <th>FechaCreación</th>
                <th>Paginas</th>
                <th>Calificación</th>
                <th>Agregar Libro</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var list in Listas)
            {
                bool isChecked = seleccionadosMap.ContainsKey(list.l.idLibro) && seleccionadosMap[list.l.idLibro];

                <tr class="table-dark custom-padding-table">
                    <td >@list.l.titulo</td>
                    <td>@list.g.genero</td>
                    <td>@list.l.autor</td>
                    <td>@list.l.editorial</td>
                    <td>@list.l.fechaCreacion</td>
                    <td>@list.l.cantidadPaginas</td>
                    <td>@list.l.calificacionPromedio</td>
                    <td><div>
                        <InputCheckbox
                            Value="isChecked"
                            ValueChanged="@(v => OnCheckChanged(list.l.idLibro, v))"
                            ValueExpression="@(() => isChecked)"
                            class="form-check-input" />
                    </div></td>
                </tr>                 
            }   
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary mt-3">Registrar</button>
</EditForm>
@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <p class="text-warning mt-3">@mensaje</p>
}
<br><br><br><br>