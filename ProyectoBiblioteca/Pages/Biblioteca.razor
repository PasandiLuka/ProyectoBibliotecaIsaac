@page "/biblioteca"
@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Threading.Tasks;

@using Microsoft.Extensions.Configuration;
@using Microsoft.EntityFrameworkCore;
@using ProyectoBiblioteca.Data
@using ProyectoBiblioteca.Data.Configs
@using ProyectoBiblioteca.Models

@inherits BibliotecaFormBase


@inject NavigationManager nv
@if(ls.UsuarioActual is null || ls.UsuarioActual == 0)
{
    nv.NavigateTo("/");
}

@inject IDbContextFactory<ProyectoBibliotecaDbContext> DbFactory
@*using var db = DbFactory.CreateDbContext();
*@


@{
    var Listas = FiltrarTitulo();
}

<h2 class="title">Títulos de Nuestra Biblioteca</h2>
<h5 class="title custom-title-padding-bottom">Seleccioná los libros que quieras agregar:</h5>

<div class="filtros-wrapper">
    <div class="content-end">
        <input class="form-control w-25 me-sm-2" type="search"
               placeholder="Ingrese un titulo para filtrar" @bind-value="titulo">

        <button class="btn btn-primary my-2 my-sm-0" type="submit" @onclick="Filtrar">
            Buscar
        </button>
    </div>
</div>



<EditForm EditContext="@editContext" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="tabla-responsive-wrapper">
        <table class="tabla-estilizada">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Género</th>
                    <th>Autor</th>
                    <th>Editorial</th>
                    <th>Fecha Creación</th>
                    <th>Páginas</th>
                    <th>Agregar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var list in Listas)
                {
                    bool isChecked = seleccionadosMap.ContainsKey(list.l.idLibro) && seleccionadosMap[list.l.idLibro];

                    <tr>
                        <td>@list.l.titulo</td>
                        <td>@list.g.genero</td>
                        <td>@list.l.autor</td>
                        <td>@list.l.editorial</td>
                        <td>@list.l.fechaCreacion.ToShortDateString()</td>
                        <td>@list.l.cantidadPaginas</td>
                        <td>
                            <InputCheckbox
                                Value="isChecked"
                                ValueChanged="@(v => OnCheckChanged(list.l.idLibro, v))"
                                ValueExpression="@(() => isChecked)"
                                class="form-check-input checkbox-style" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="button-align">
        <button type="submit" class="btn btn-primary mt-4">Registrar</button>
    </div>
</EditForm>
@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <p class="text-warning mt-3">@mensaje</p>
}
<br><br><br><br>


@code{
    string titulo = string.Empty;
    public void Filtrar()
    {
        StateHasChanged();
    }
    public List<(Genero g, Libro l)> FiltrarTitulo()
    {
        using var db = DbFactory.CreateDbContext();

        if (!string.IsNullOrEmpty(titulo))
        {

        string filtro = titulo.ToLower();

        var query = (
                from l in db.Libros
                join g in db.Generos on l.idGenero equals g.idGenero
                where l.titulo.ToLower().Contains(filtro)   // búsqueda parcial
                select new { g, l }
            )
            .AsEnumerable()
            .Select(x => (x.g, x.l))
            .ToList();

        return query;
            
        }
        else
        {
            var query = (
                from l in db.Libros
                join g in db.Generos on l.idGenero equals g.idGenero
                select new { g, l }
            )
            .AsEnumerable()
            .Select(x => (x.g, x.l))
            .ToList();

            return query;
        }
    }


}