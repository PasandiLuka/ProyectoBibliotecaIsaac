@page "/librosApi"
@namespace ProyectoBiblioteca.Pages
@inject HttpClient Http

<h3>Buscador Google Books</h3>

<input @bind="searchQuery" placeholder="Ingrese el título o palabra clave" />
<button @onclick="BuscarLibros">Buscar</button>

@if (isLoading)
{
    <p>Cargando...</p>
}
else if (books?.Items != null && books.Items.Count > 0)
{
    <h3>Se encontraron @books.Items.Count libros:</h3>
    <div class="row">
        @foreach (var item in books.Items)
        {
            <div class="col-md-2  mb-3">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(item.volumeInfo.imageLinks?.thumbnail))
                    {
                        <img src="@item.volumeInfo.imageLinks.thumbnail" class="card-img-top" alt="@item.volumeInfo.title" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@item.volumeInfo.title</h5>
                        <p class="card-text">
                            <strong>Autor(es):</strong> @string.Join(", ", item.volumeInfo.authors ?? new List<string>())<br />
                            <strong>Publicado:</strong> @item.volumeInfo.publishedDate
                            <strong>CantidadDePaginas:</strong> @item.volumeInfo.pageCount
                            <strong>Categoria:</strong> @string.Join(", ", item.volumeInfo.categories ?? new List<string>())<br />
                        </p>
                        <p class="card-text text-muted" style="font-size: 0.9em;">
                            @(string.IsNullOrWhiteSpace(item.volumeInfo.description) 
                                ? "Sin descripción" 
                                : item.volumeInfo.description.Length > 250 
                                    ? item.volumeInfo.description.Substring(0, 250) + "..." 
                                    : item.volumeInfo.description)
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (!string.IsNullOrWhiteSpace(searchQuery))
{
    <p>No se encontraron resultados.</p>
}
@code{

    private string searchQuery = "";
    private bool isLoading = false;
    private GoogleBooksResponse? books;

    private async Task BuscarLibros()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
            return;

        isLoading = true;

        string url = $"https://www.googleapis.com/books/v1/volumes?q=intitle:{searchQuery}&maxResults=30";

        try
        {
            books = await Http.GetFromJsonAsync<GoogleBooksResponse>(url);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al consumir la API: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}


