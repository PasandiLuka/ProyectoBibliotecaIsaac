@* @page "/hola"
@using ProyectoBiblioteca.Data;
@using ProyectoBiblioteca.Models;

<h1>Bienvenido</h1>

<p>Escribí algo:</p>

<input @bind="nombreCompleto" placeholder="Escribí tu texto aquí" />

<input @bind="nombreUsuario" placeholder="Escribí tu texto aquí" />

<input @bind="correo" placeholder="Escribí tu texto aquí" />

<input @bind="contrasena" placeholder="Escribí tu texto aquí" />

<input @bind="numeroTelefono" placeholder="Escribí tu texto aquí" />

<input @bind="dinero" placeholder="Escribí tu texto aquí" />

<button class="btn btn-primary" @onclick="Subir">Subir</button>

<p>Error: @mensaje</p>

@code {
    public string nombreCompleto = string.Empty;
    public string nombreUsuario = string.Empty;
    public string correo = string.Empty;
    public string contrasena =  string.Empty;
    public string numeroTelefono = string.Empty;
    public decimal dinero = 0;
    public string mensaje = string.Empty;

    private void Subir()
    {
        if(!Usuario.ValidarNombre(nombreCompleto))
        using (var context = new ProyectoBibliotecaDbContext())
        {
            var usuario1 = new Usuario(nombreCompleto, nombreUsuario, correo, contrasena, numeroTelefono, dinero);
            context.Usuario.Add(usuario1);
            context.SaveChanges();
        }
    }
}

@if(Usuario.ValidarNombre(nombreCompleto))
{
    mensaje = "El nombre debe contener minimo 3 caracteres";
}else
{
    mensaje = "";
}
 *@