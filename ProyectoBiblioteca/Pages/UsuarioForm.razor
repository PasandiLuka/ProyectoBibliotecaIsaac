@page "/usuario"
@namespace ProyectoBiblioteca.Pages
@inherits UsuarioFormBase

<h3>Registro de Usuario</h3>

<EditForm EditContext="@editContext" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />


    <div>
        <label>Nombre completo:</label>
        <InputText @bind-Value="usuario.nombreCompleto" class="form-control" />
        <ValidationMessage For="@(() => usuario.nombreCompleto)" />
    </div>

    <div>
        <label>Nombre de usuario:</label>
        <InputText @bind-Value="usuario.nombreUsuario" class="form-control" placeholder="Nombre de usuario"/>
        <ValidationMessage For="@(() => usuario.nombreUsuario)" />
    </div>

    <div>
        <label>Correo electrónico:</label>
        <InputText @bind-Value="usuario.correo" class="form-control" />
        <ValidationMessage For="@(() => usuario.correo)" />
    </div>

    <div>
        <label>Contraseña:</label>
        <InputText @bind-Value="usuario.contrasena" type="password" class="form-control" />
        <ValidationMessage For="@(() => usuario.contrasena)" />
    </div>

    <div>
        <label>Teléfono:</label>
        <InputText @bind-Value="usuario.numeroTelefono" class="form-control" />
        <ValidationMessage For="@(() => usuario.numeroTelefono)" />
    </div>

    <div>
        <label>Dinero disponible:</label>
        <InputNumber @bind-Value="usuario.dinero" class="form-control" />
        <ValidationMessage For="@(() => usuario.dinero)" />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Registrar</button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <p class="text-success mt-3">@mensaje</p>
}