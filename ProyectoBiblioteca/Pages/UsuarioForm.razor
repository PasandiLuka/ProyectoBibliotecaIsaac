@page "/usuario"
@using ProyectoBiblioteca.FormLogic
@namespace ProyectoBiblioteca.Pages
@inherits UsuarioFormBase

<div class="login-container">
    <div class="login-box">
        <h2 class="text-center">Registro de Usuario</h2>

        <EditForm EditContext="@editContext" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label>Nombre completo:</label>
                <InputText @bind-Value="usuario.nombreCompleto" class="form-control" placeholder="Nombre Completo"/>
                <p class="text-danger mt-3"><ValidationMessage For="@(() => usuario.nombreCompleto)" /></p>
            </div>

            <div class="mb-3">
                <label>Nombre de usuario:</label>
                <InputText @bind-Value="usuario.nombreUsuario" class="form-control" placeholder="Nombre de Usuario"/>
                <p class="text-danger mt-3"><ValidationMessage For="@(() => usuario.nombreUsuario)" /></p>
            </div>

            <div class="mb-3">
                <label>Correo electrónico:</label>
                <InputText @bind-Value="usuario.correo" class="form-control" placeholder="Correo Electrónico"/>
                <p class="text-danger mt-3"><ValidationMessage For="@(() => usuario.correo)" /></p>
            </div>

            <div class="mb-3">
                <label>Contraseña:</label>
                <InputText @bind-Value="usuario.contrasena" type="password" class="form-control" placeholder="Contraseña"/>
                <p class="text-danger mt-3"><ValidationMessage For="@(() => usuario.contrasena)" /></p>
            </div>

            <div class="mb-3">
                <label>Teléfono:</label>
                <InputText @bind-Value="usuario.numeroTelefono" class="form-control" placeholder="Número de Teléfono"/>
                <p class="text-danger mt-3"><ValidationMessage For="@(() => usuario.numeroTelefono)" /></p>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary mt-2">Registrar</button>
                <a href="/" class="btn btn-outline-secondary mt-2">Volver al Inicio</a>
            </div>
        </EditForm>
    </div>
</div>
