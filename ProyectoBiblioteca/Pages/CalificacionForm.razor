@page "/calificacion"
@using ProyectoBiblioteca.FormLogic
@inherits CalificacionFormBase
@inject CalificacionService CalificacionService

@namespace ProyectoBiblioteca.Pages
@*
<h2>Registro de Usuario</h2>

<EditForm EditContext="@editContext" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div>
        <label>Nombre completo:</label>
        <InputNumber TValue="float" @bind-Value="calificacion.calificacion" class="form-control" placeholder="Calificacion"/>
        <ValidationMessage For="@(() => calificacion.calificacion)" />
    </div>

    <button type="submit" @onclick="OnRegistrarClick" class="btn btn-primary mt-3">Registrar</button>
    <button>Agregar Calificación</button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <p class="text-success mt-3">@mensaje</p>
}

@code {
    private async Task OnRegistrarClick()
    {
        await AgregarCalificacion(calificacion.calificacion);
    }

    private async Task AgregarCalificacion(int idLibro, int idUsuario, float calificacion)
    {
        await CalificacionService.AgregarCalificacionAsync(idLibro, idUsuario, calificacion);
    }   
}
*@