@page "/index"
@using System;
@using System.Collections.Generic;
@using System.Linq;
@using System.Threading.Tasks;

@using Microsoft.Extensions.Configuration;
@using Microsoft.EntityFrameworkCore;
@using ProyectoBiblioteca.Data
@using ProyectoBiblioteca.Data.Configs
@using ProyectoBiblioteca.Models

@inject LoginState ls

@inject IDbContextFactory<ProyectoBibliotecaDbContext> DbFactory
@*using var db = DbFactory.CreateDbContext();
*@

@{
    using var db = DbFactory.CreateDbContext();
    var Listas = (from l in db.Libros 
                  join b in db.Bibliotecas on l.idLibro equals b.idLibro 
                  join g in db.Generos on l.idGenero equals g.idGenero 
                  join u in db.Usuarios on b.idUsuario equals u.idUsuario
                  where u.idUsuario == ls.UsuarioActual
                  select new {l, g}).ToList();
} 

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
        <h2 class="title">Bienvenidos a su Biblioteca de Netflix.</h2>
        <h5 class="title custom-title-padding-bottom">Libros que ustede posee:</h5>

    <div class="tabla-responsive-wrapper">
    <table class="tabla-estilizada">
        <thead>
            <tr>
                <th>Título</th>
                <th>Género</th>
                <th>Autor</th>
                <th>Editorial</th>
                <th>Fecha Creación</th>
                <th>Páginas</th>
                <th>Calificación</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var list in Listas)
            {
                <tr>
                    <td>@list.l.titulo</td>
                    <td>@list.g.genero</td>
                    <td>@list.l.autor</td>
                    <td>@list.l.editorial</td>
                    <td>@list.l.fechaCreacion.ToShortDateString()</td>
                    <td>@list.l.cantidadPaginas</td>
                    <td>@list.l.calificacionPromedio</td>        
                </tr>                 
            }
        </tbody>
    </table>
</div>
    <br><br>
</body>
</html>
